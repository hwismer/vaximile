/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run . -profile test,<docker/singularity/conda> --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   '1.h'
    ]
}

params {
    // Fixtures are empty placeholders: enough for `nextflow inspect` to resolve the DAG,
    // not enough to produce results. Swap in a downsampled tumour/normal pair plus a small
    // RNA sample, and a trimmed VEP cache, for a test that actually executes.
    samplesheet   = "${projectDir}/assets/test/samplesheet.csv"
    capture_kits  = "${projectDir}/assets/test/capture_kits.csv"
    vep_cache     = "${projectDir}/assets/test"

    scatter_count = 2
}
