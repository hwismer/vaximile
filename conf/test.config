/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run . -profile test,<docker/singularity/conda> --outdir <OUTDIR>
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus:   4,
        memory: '15.GB',
        time:   '1.h'
    ]

    // ASCAT is the one vendored nf-core module, and its stub still runs
    // `Rscript -e "library(ASCAT); ..."` to capture a version. That needs its container,
    // so it fails an offline stub run with "Unable to evaluate output" - a terminal error
    // no errorStrategy can ignore, which then kills the whole run.
    //
    // Switching off its `when:` guard skips the process entirely and keeps
    // `-profile test -stub-run` self-contained. To exercise ASCAT too, run with a
    // container engine and drop this line:
    //     nextflow run . -profile test,docker -stub-run -c <config setting ext.when = true>
    withName: 'ASCAT' {
        ext.when = false
    }
}

params {
    // Every fixture here is an EMPTY placeholder. That is enough for `-stub-run`, which
    // stages inputs but never executes a script, so file contents are never read:
    //
    //     nextflow run . -profile test -stub-run
    //
    // which exercises the whole DAG - every output declaration, tuple arity and process
    // invocation count - in seconds, offline, with no containers and no conda.
    //
    // It is NOT enough to produce results. For a test that actually runs tools, swap in a
    // downsampled tumour/normal pair, a small RNA sample and a trimmed VEP cache.
    //
    // The reference parameters are overridden purely to keep the stub run offline: the
    // defaults in nextflow.config are remote https:// and gs:// URIs, and Nextflow stages
    // inputs even under -stub-run, so leaving them would download tens of gigabytes.
    samplesheet             = "${projectDir}/assets/test/samplesheet.csv"
    capture_kits            = "${projectDir}/assets/test/capture_kits.csv"
    vep_cache               = "${projectDir}/assets/test"

    reference_fa            = "${projectDir}/assets/test/refs/genome.fa"
    gtf                     = "${projectDir}/assets/test/refs/annotation.gtf.gz"
    transcriptome_reference = "${projectDir}/assets/test/refs/transcriptome.fa.gz"
    human_ref_peptides      = "${projectDir}/assets/test/refs/peptides.fa.gz"

    hla_fasta               = "${projectDir}/assets/test/refs/hla.fasta"
    hla_fasta_fai           = "${projectDir}/assets/test/refs/hla.fasta.fai"
    hla_kmers               = "${projectDir}/assets/test/refs/hla_kmers.uniq"
    hla_freq                = "${projectDir}/assets/test/refs/hla_freq.txt"

    // Each of these also needs a sibling .tbi: main.nf pairs every resource VCF with
    // file("${param}.tbi").
    common_germline         = "${projectDir}/assets/test/refs/common_germline.vcf.gz"
    known_sites_dbsnp       = "${projectDir}/assets/test/refs/dbsnp.vcf.gz"
    known_sites_1000g_snps  = "${projectDir}/assets/test/refs/1000g_snps.vcf.gz"
    known_indels            = "${projectDir}/assets/test/refs/known_indels.vcf.gz"
    gnomad                  = "${projectDir}/assets/test/refs/gnomad.vcf.gz"
    pon                     = "${projectDir}/assets/test/refs/pon.vcf.gz"
    hapmap                  = "${projectDir}/assets/test/refs/hapmap.vcf.gz"
    mills                   = "${projectDir}/assets/test/refs/mills.vcf.gz"
    somalier_sites          = "${projectDir}/assets/test/refs/somalier_sites.vcf.gz"

    scatter_count = 2
}
