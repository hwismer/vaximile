/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Institutional config: UCSF Wynton / krummellab
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Layered on top of nextflow.config, which supplies the parameter defaults, the
    container profiles and the outputDir/output mode the `output {}` block relies on.

        nextflow run . -c conf/ucsf_krummellab.config -params-file params.json -resume

    This must be -c (merge), not the -C (replace) used before the reorganisation:
    parameter defaults now live in nextflow.config, and -C would discard them.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor       = "slurm"
    time           = 14.d
    scratch        = true
    queue          = "krummellab,common"
    clusterOptions = '--gres=scratch:250G'
    errorStrategy  = 'ignore'
    maxRetries     = 2
}

executor {
    name      = "slurm"
    queueSize = 50
}

conda.enabled = true

apptainer {
    enabled     = true
    autoMounts  = true
    runOptions  = '--writable-tmpfs --cleanenv -e --no-home --env PYTHONNOUSERSITE=1 -B $SINGULARITY_TMPDIR:/tmp -B $SINGULARITY_TMPDIR:/scratch'
    pullTimeout = "30min"
}

// Listed alongside nf-schema because a merged plugins block replaces rather than
// extends the one in nextflow.config.
plugins {
    id 'nf-schema@2.1.1'
    id 'nf-google'
}
