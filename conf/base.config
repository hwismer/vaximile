/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    vaximile base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Every module carries one process_* label instead of its own cpus/memory. The tiers
    below are a ladder: each module was placed in the smallest tier that meets or
    exceeds what it previously requested in both CPUs and memory, so no process is
    under-provisioned relative to the values it ran with before.

    To retune a single module without editing it, add a withName block in a config
    passed with -c. See docs/usage.md.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // Applies to anything that somehow carries no label.
    cpus   = { 1    * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 }
        memory = { 48.GB * task.attempt }
    }
    // Eight cores but memory-hungry: pVACfuse and Manta-class jobs.
    withLabel: process_high_memory {
        cpus   = { 8 }
        memory = { 96.GB * task.attempt }
    }
    // Aligners and deep-learning callers.
    withLabel: process_very_high {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }
    withLabel: process_max {
        cpus   = { 32 }
        memory = { 96.GB * task.attempt }
    }
    // Arriba only. Its 350 GB request is the single largest in the pipeline; worth
    // re-measuring, since it forces a whole-node reservation on most clusters.
    withLabel: process_max_memory {
        cpus   = { 8 }
        memory = { 384.GB * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
