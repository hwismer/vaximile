// Resource tiers. Each module carries one process_* label; override a single process with withName in a -c config.

process {

    // Default for any process without a label.
    cpus   = { 1    * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
    }
    // Mostly single-threaded tools that need a large Java heap.
    withLabel: process_low_memory {
        cpus   = { 2 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 }
        memory = { 48.GB * task.attempt }
    }
    // Arriba, pVACfuse and the BWA index build.
    withLabel: process_high_memory {
        cpus   = { 8 }
        memory = { 96.GB * task.attempt }
    }
    // BWA, DeepVariant, pVACseq, salmon and STAR-Fusion.
    withLabel: process_very_high {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }
    withLabel: process_max {
        cpus   = { 32 }
        memory = { 96.GB * task.attempt }
    }

    // SAMTOOLS_SORMADUP is an nf-core module labelled process_medium; size it like BWA_MAP instead.
    withName: 'SAMTOOLS_SORMADUP' {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
