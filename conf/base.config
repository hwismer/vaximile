/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    vaximile base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Every module carries one process_* label instead of its own cpus/memory. The tiers
    below are a ladder: each module was placed in the smallest tier that meets or
    exceeds what it previously requested in both CPUs and memory, so no process is
    under-provisioned relative to the values it ran with before.

    To retune a single module without editing it, add a withName block in a config
    passed with -c. See the README.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // Applies to anything that somehow carries no label.
    cpus   = { 1    * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
    }
    // Single-threaded tools that still need a real heap. Same memory as process_medium but
    // two CPUs instead of four: none of these pass task.cpus to anything, so the extra cores
    // were only ever a scheduling cost. Two rather than one because several are JVM tools
    // whose garbage collector is parallel, and three of them size their heap from
    // task.memory (-Xmx${task.memory.toGiga() - 1}g), so the memory must not drop.
    withLabel: process_low_memory {
        cpus   = { 2 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 }
        memory = { 48.GB * task.attempt }
    }
    // Eight cores but memory-hungry: pVACfuse and Manta-class jobs.
    withLabel: process_high_memory {
        cpus   = { 8 }
        memory = { 96.GB * task.attempt }
    }
    // Aligners and deep-learning callers.
    withLabel: process_very_high {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }
    withLabel: process_max {
        cpus   = { 32 }
        memory = { 96.GB * task.attempt }
    }

    // The one module that cannot simply carry a tier label. SAMTOOLS_SORMADUP is a
    // vendored nf-core module kept byte-identical to upstream so `nf-core modules update`
    // still works on it, and its 'process_medium' label is baked into that file. A label
    // cannot be added from config, so its resources are set by name here instead. The
    // values are process_very_high, matching BWA_MAP - it is the other half of the same
    // per-sample alignment step.
    //
    // Note the module pipes five samtools stages together and passes --threads to four of
    // them, so the thread request is nominally 4x this number. In practice the middle
    // stages hand off uncompressed BAM (-u) and stay mostly idle; the time is in
    // `samtools sort`, which is what these cores actually buy.
    withName: 'SAMTOOLS_SORMADUP' {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
