// Resource tiers. Each module carries one process_* label; retune one with a withName block in a -c config.

process {

    // Applies to anything that somehow carries no label.
    cpus   = { 1    * task.attempt }
    memory = { 8.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
    }
    // Single-threaded tools that still need a large heap (several size -Xmx from task.memory).
    withLabel: process_low_memory {
        cpus   = { 2 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 }
        memory = { 48.GB * task.attempt }
    }
    // Eight cores but memory-hungry: pVACfuse and Manta-class jobs.
    withLabel: process_high_memory {
        cpus   = { 8 }
        memory = { 96.GB * task.attempt }
    }
    // Aligners and deep-learning callers.
    withLabel: process_very_high {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }
    withLabel: process_max {
        cpus   = { 32 }
        memory = { 96.GB * task.attempt }
    }

    // SAMTOOLS_SORMADUP is a vendored nf-core module with process_medium baked in, so it is sized by name,
    // matching BWA_MAP (the other half of the per-sample alignment step).
    withName: 'SAMTOOLS_SORMADUP' {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
