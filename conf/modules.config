/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        ext.args   = Additional arguments appended to the command in the module.
        ext.prefix = File name prefix for output files.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Publishing is handled by the `output {}` block in vaximile.nf, not by per-process
    publishDir directives, so this file covers tool arguments only.

    !! THESE VALUES ARE NOT OPTIONAL DEFAULTS. !!

    Each block below reproduces flags that were previously hard-coded in the module's
    script and have been moved out of it. A module whose selector stops matching falls
    back to `task.ext.args ?: ''` and silently loses those flags. That is a real
    correctness hazard for several entries, called out inline below.

    Only tunable flags were hoisted. Arguments that determine whether a process is
    correct at all stayed in the module scripts: I/O paths and their flags, reference
    files arriving as process inputs, anything derived from task.cpus / task.memory,
    `--format vcf --vcf` for VEP, `--plugin Frameshift --plugin Wildtype` (required by
    downstream pVACtools), `--create-output-*-index` where the index is a declared
    output, and `-f PASS` in both FILTER_VCF modules.

    ext.prefix is set by no block here; every module that supports it defaults to the
    filename stem it used before, so output names are unchanged. Set one to rename a
    module's outputs.

    On selectors: three process names exist in two module files each (FILTER_VCF,
    POSTPROCESS_VCF, VEP_ANNOTATE - see docs/nf-core-migration.md). The bare selectors
    below are deliberate and safe: both VEP_ANNOTATE modules had an identical flag set,
    the germline POSTPROCESS_VCF has no $args in its script and ignores the value, and
    neither FILTER_VCF hoisted anything. A scoped selector would be more precise but
    would fail silently if the workflow path ever changed.
*/

process {

    // -----------------------------------------------------------------------
    // Read QC and alignment
    // -----------------------------------------------------------------------

    // REQUIRED: without this fastp stops auto-detecting paired-end adapters.
    withName: 'FASTP' {
        ext.args = '--detect_adapter_for_pe'
    }

    // REQUIRED: SAMTOOLS_SORMADUP is an unmodified nf-core module that names its output
    // from meta.id. BAM_MARKDUPLICATES supplies that id; the suffix here keeps the
    // "<sample>_<molecule>_markdup.bam" names MarkDuplicatesSpark produced, so published
    // paths and anything matching on them are unchanged.
    //
    // args5 goes to `samtools markdup`. -S marks supplementary alignments of a duplicate
    // template as duplicates, which is what MarkDuplicatesSpark did; without it those
    // reads stay unflagged and downstream depth differs. Optical duplicate tagging (-d)
    // is deliberately not set: it needs a flowcell-specific pixel distance, and the
    // Spark module emitted no metrics, so nothing here consumed optical counts before.
    //
    // --json is required for MultiQC to see these stats at all. MultiQC's text pattern for
    // samtools markdup is broken - it matches `contents: ['^COMMAND:', 'samtools markdup']`,
    // and `contents` is a literal substring match, so the regex anchor `^` can never match
    // real output (confirmed against MultiQC 1.35: prepending a literal '^' to the file is
    // what makes it parse). The JSON pattern uses a genuine literal, '"COMMAND":', which
    // JSON output does contain, and MultiQC then produces a samtools-markdup section with
    // read/written/examined/duplicate counts. --json also implies -s.
    //
    // The file keeps the .metrics name because the module hardcodes `-f <prefix>.metrics`
    // and the prefix also names the BAM; MultiQC matches on content, not extension.
    withName: 'SAMTOOLS_SORMADUP' {
        ext.prefix = { "${meta.id}_markdup" }
        ext.args5  = '-S --json'
    }

    // -----------------------------------------------------------------------
    // Germline variant calling
    // -----------------------------------------------------------------------

    // Matches GATK's own default for --emit-ref-confidence, so losing it is harmless.
    withName: 'HAPLOTYPE_CALLER_SCATTER' {
        ext.args = '-ERC NONE'
    }

    // REQUIRED: these tranches define the CNN filtering sensitivity.
    withName: 'HAPLOTYPE_CALLER_FILTER_VARIANTS' {
        ext.args = '--info-key CNN_1D --snp-tranche 99.95 --indel-tranche 99.4'
    }

    // REQUIRED: PRIORITIZE resolves conflicting genotypes, and --minimumN 2 is the
    // two-caller consensus requirement.
    withName: 'MERGE_GERMLINE_VCFS' {
        ext.args = '-genotypeMergeOptions PRIORITIZE --minimumN 2'
    }

    // REQUIRED: enables the variant statistics report and the small-model bypass.
    withName: 'DEEPVARIANT' {
        ext.args = '--vcf_stats_report=true --disable_small_model=true'
    }

    // -----------------------------------------------------------------------
    // Somatic variant calling
    // -----------------------------------------------------------------------

    // REQUIRED: --use_default_pon_filtering applies the packaged panel of normals.
    withName: 'DEEPSOMATIC' {
        ext.args = '--vcf_stats_report=true --use_default_pon_filtering=true'
    }

    // REQUIRED: bcftools concat flags for overlapping Strelka SNV and indel records.
    withName: 'POSTPROCESS_STRELKA' {
        ext.args = '--allow-overlaps --remove-duplicates'
    }

    // REQUIRED: this is the 2-of-3 caller consensus that defines the somatic callset.
    // Losing it would emit every variant called by any single caller.
    withName: 'MERGE_SOMATIC_VCFS' {
        ext.args = '--minimumN 2'
    }

    // REQUIRED: multiallelic splitting and exact-duplicate removal before annotation.
    // Applies to the somatic module; the germline POSTPROCESS_VCF ignores ext.args.
    withName: 'POSTPROCESS_VCF' {
        ext.args = '-m -any -d exact'
    }

    // -----------------------------------------------------------------------
    // Annotation and filtering
    // -----------------------------------------------------------------------

    // REQUIRED: drops the annotation fields pVACtools consumes. Applies to both the
    // somatic and germline VEP_ANNOTATE modules, which had identical flag sets.
    withName: 'VEP_ANNOTATE' {
        ext.args = '--everything --symbol --terms SO --mane_select --canonical --tsl --biotype --hgvs --pick --transcript_version'
    }

    // REQUIRED: this IS the population filter. Empty args passes everything through.
    withName: 'VEP_POPULATION_FILTER' {
        ext.args = '--filter "gnomADe_AF < 0.001 or not gnomADe_AF"'
    }

    // -----------------------------------------------------------------------
    // RNA quantification
    // -----------------------------------------------------------------------

    // salmon's own default k, so losing it is harmless.
    withName: 'CREATE_SALMON_INDEX' {
        ext.args = '-k 31'
    }

    // REQUIRED: automatic library-type detection and selective-alignment validation.
    // Order-sensitive: --libType must reach salmon before -1/-2, so the module places
    // $args ahead of the read files. Keep --libType here rather than moving it into the
    // script, and do not reorder $args in modules/local/salmon_quant/main.nf.
    withName: 'SALMON_QUANT' {
        ext.args = '--libType A --validateMappings'
    }

    // -----------------------------------------------------------------------
    // HLA typing
    // -----------------------------------------------------------------------

    withName: 'MHCFLOW' {
        ext.args = '--min-ecnt 1'
    }

    // -----------------------------------------------------------------------
    // Neoantigen prediction
    // -----------------------------------------------------------------------

    // REQUIRED: epitope lengths, and the scoring/filtering behaviour of the
    // predictions. Note --top-score-metric2 is preserved verbatim from the original
    // script; it looks like a typo for --top-score-metric.
    withName: 'PVACSEQ' {
        ext.args = "-e1 8,9,10,11 -e2 12,13,14,15,16,17,18 --pass-only --run-reference-proteome-similarity --run-ml-predictions --top-score-metric2 'combined_percentile','ic50' -m median -a sample_name --problematic-amino-acids P:-2"
    }

    // REQUIRED: as above, for fusion-derived epitopes.
    withName: 'PVACFUSE' {
        ext.args = "-e1 8,9,10,11 -e2 12,13,14,15,16,17,18 -m median --top-score-metric2 'combined_percentile','ic50'"
    }
}
