// Per-module tool arguments (ext.args) and output prefixes (ext.prefix).
// These flags were moved out of the module scripts: a selector that stops matching silently drops them.
// FILTER_VCF, POSTPROCESS_VCF and VEP_ANNOTATE each name two modules; the bare selectors below are safe for both.

process {

    // -----------------------------------------------------------------------
    // Read QC and alignment
    // -----------------------------------------------------------------------

    // REQUIRED: without this fastp stops auto-detecting paired-end adapters.
    withName: 'FASTP' {
        ext.args = '--detect_adapter_for_pe'
    }

    // REQUIRED: keeps the <sample>_<molecule>_markdup.bam naming. -S marks supplementary reads of duplicates;
    // --json is needed for MultiQC to parse the markdup stats.
    withName: 'SAMTOOLS_SORMADUP' {
        ext.prefix = { "${meta.id}_markdup" }
        ext.args5  = '-S --json'
    }

    // -----------------------------------------------------------------------
    // Germline variant calling
    // -----------------------------------------------------------------------

    // Matches GATK's own default for --emit-ref-confidence, so losing it is harmless.
    withName: 'HAPLOTYPE_CALLER_SCATTER' {
        ext.args = '-ERC NONE'
    }

    // REQUIRED: these tranches define the CNN filtering sensitivity.
    withName: 'HAPLOTYPE_CALLER_FILTER_VARIANTS' {
        ext.args = '--info-key CNN_1D --snp-tranche 99.95 --indel-tranche 99.4'
    }

    // REQUIRED: PRIORITIZE resolves conflicting genotypes, and --minimumN 2 is the
    // two-caller consensus requirement.
    withName: 'MERGE_GERMLINE_VCFS' {
        ext.args = '-genotypeMergeOptions PRIORITIZE --minimumN 2'
    }

    // REQUIRED: enables the variant statistics report and the small-model bypass.
    withName: 'DEEPVARIANT' {
        ext.args = '--vcf_stats_report=true --disable_small_model=true'
    }

    // -----------------------------------------------------------------------
    // Somatic variant calling
    // -----------------------------------------------------------------------

    // REQUIRED: --use_default_pon_filtering applies the packaged panel of normals.
    withName: 'DEEPSOMATIC' {
        ext.args = '--vcf_stats_report=true --use_default_pon_filtering=true'
    }

    // REQUIRED: bcftools concat flags for overlapping Strelka SNV and indel records.
    withName: 'POSTPROCESS_STRELKA' {
        ext.args = '--allow-overlaps --remove-duplicates'
    }

    // REQUIRED: this is the 2-of-3 caller consensus that defines the somatic callset.
    // Losing it would emit every variant called by any single caller.
    withName: 'MERGE_SOMATIC_VCFS' {
        ext.args = '--minimumN 2'
    }

    // REQUIRED: multiallelic splitting and exact-duplicate removal before annotation.
    // Applies to the somatic module; the germline POSTPROCESS_VCF ignores ext.args.
    withName: 'POSTPROCESS_VCF' {
        ext.args = '-m -any -d exact'
    }

    // -----------------------------------------------------------------------
    // Annotation and filtering
    // -----------------------------------------------------------------------

    // REQUIRED: drops the annotation fields pVACtools consumes. Applies to both the
    // somatic and germline VEP_ANNOTATE modules, which had identical flag sets.
    withName: 'VEP_ANNOTATE' {
        ext.args = '--everything --symbol --terms SO --mane_select --canonical --tsl --biotype --hgvs --pick --transcript_version'
    }

    // REQUIRED: this IS the population filter. Empty args passes everything through.
    withName: 'VEP_POPULATION_FILTER' {
        ext.args = '--filter "gnomADe_AF < 0.001 or not gnomADe_AF"'
    }

    // -----------------------------------------------------------------------
    // RNA quantification
    // -----------------------------------------------------------------------

    // salmon's own default k, so losing it is harmless.
    withName: 'CREATE_SALMON_INDEX' {
        ext.args = '-k 31'
    }

    // REQUIRED: library-type detection and mapping validation. --libType must precede -1/-2, so keep it here.
    withName: 'SALMON_QUANT' {
        ext.args = '--libType A --validateMappings'
    }

    // -----------------------------------------------------------------------
    // HLA typing
    // -----------------------------------------------------------------------

    withName: 'MHCFLOW' {
        ext.args = '--min-ecnt 1'
    }

    // -----------------------------------------------------------------------
    // Neoantigen prediction
    // -----------------------------------------------------------------------

    // REQUIRED: epitope lengths, and the scoring/filtering behaviour of the
    // predictions. Note --top-score-metric2 is preserved verbatim from the original
    // script; it looks like a typo for --top-score-metric.
    withName: 'PVACSEQ' {
        ext.args = "-e1 8,9,10,11 -e2 12,13,14,15,16,17,18 --pass-only --run-reference-proteome-similarity --run-ml-predictions --top-score-metric2 'combined_percentile','ic50' -m median -a sample_name --problematic-amino-acids P:-2"
    }

    // REQUIRED: as above, for fusion-derived epitopes.
    withName: 'PVACFUSE' {
        ext.args = "-e1 8,9,10,11 -e2 12,13,14,15,16,17,18 -m median --top-score-metric2 'combined_percentile','ic50'"
    }
}
