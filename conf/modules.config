// Tool arguments (ext.args) and output prefixes (ext.prefix), passed to each module's command.
// A selector that no longer matches a process name drops its arguments silently, so rename both together.

process {

    // -----------------------------------------------------------------------
    // Read QC and alignment
    // -----------------------------------------------------------------------

    // Detect adapter sequences too, on top of fastp's overlap-based trimming for paired reads.
    withName: 'FASTP' {
        ext.args = '--detect_adapter_for_pe'
    }

    // <sample>_<molecule>_markdup.bam naming. -S also marks supplementary reads of duplicates; --json is for MultiQC.
    withName: 'SAMTOOLS_SORMADUP' {
        ext.prefix = { "${meta.id}_markdup" }
        ext.args5  = '-S --json'
    }

    // -----------------------------------------------------------------------
    // Germline variant calling
    // -----------------------------------------------------------------------

    // Plain VCF, no reference-confidence blocks.
    withName: 'HAPLOTYPE_CALLER_SCATTER' {
        ext.args = '-ERC NONE'
    }

    // CNN score tranches that set the filtering sensitivity.
    withName: 'HAPLOTYPE_CALLER_FILTER_VARIANTS' {
        ext.args = '--info-key CNN_1D --snp-tranche 99.95 --indel-tranche 99.4'
    }

    // Keep variants called by at least two callers; PRIORITIZE resolves conflicting genotypes.
    withName: 'MERGE_GERMLINE_VCFS' {
        ext.args = '-genotypeMergeOptions PRIORITIZE --minimumN 2'
    }

    // Write the stats report, and run every candidate through the full model.
    withName: 'DEEPVARIANT' {
        ext.args = '--vcf_stats_report=true --disable_small_model=true'
    }

    // -----------------------------------------------------------------------
    // Somatic variant calling
    // -----------------------------------------------------------------------

    // Write the stats report, and filter against DeepSomatic's packaged panel of normals.
    withName: 'DEEPSOMATIC' {
        ext.args = '--vcf_stats_report=true --use_default_pon_filtering=true'
    }

    // Join Strelka's SNV and indel VCFs, which can overlap.
    withName: 'POSTPROCESS_STRELKA' {
        ext.args = '--allow-overlaps --remove-duplicates'
    }

    // Keep variants called by at least two of the three somatic callers.
    withName: 'MERGE_SOMATIC_VCFS' {
        ext.args = '--minimumN 2'
    }

    // Split multiallelic sites and drop exact duplicates. Only the somatic module reads these.
    withName: 'POSTPROCESS_VCF' {
        ext.args = '-m -any -d exact'
    }

    // -----------------------------------------------------------------------
    // Annotation and filtering
    // -----------------------------------------------------------------------

    // The annotations pVACtools reads, one consequence per variant. Used by the somatic and germline modules.
    withName: 'VEP_ANNOTATE' {
        ext.args = '--everything --symbol --terms SO --mane_select --canonical --tsl --biotype --hgvs --pick --transcript_version'
    }

    // Drop variants at 0.1% or more in any 1000 Genomes or gnomAD population (VEP's MAX_AF).
    withName: 'VEP_POPULATION_FILTER' {
        ext.args = '--filter "MAX_AF < 0.001 or not MAX_AF"'
    }

    // -----------------------------------------------------------------------
    // RNA quantification
    // -----------------------------------------------------------------------

    // salmon's default k-mer length.
    withName: 'CREATE_SALMON_INDEX' {
        ext.args = '-k 31'
    }

    // Detect the library type automatically; --libType must come before -1/-2.
    withName: 'SALMON_QUANT' {
        ext.args = '--libType A --validateMappings'
    }

    // -----------------------------------------------------------------------
    // HLA typing
    // -----------------------------------------------------------------------

    withName: 'MHCFLOW' {
        ext.args = '--min-ecnt 1'
    }

    // -----------------------------------------------------------------------
    // Neoantigen prediction
    // -----------------------------------------------------------------------

    // Epitope lengths, scoring and filtering.
    withName: 'PVACSEQ' {
        ext.args = "-e1 8,9,10,11 -e2 12,13,14,15,16,17,18 --pass-only --run-reference-proteome-similarity --run-ml-predictions --top-score-metric2 'combined_percentile','ic50' -m median -a sample_name --problematic-amino-acids P:-2"
    }

    // As for pVACseq, for fusion-derived epitopes.
    withName: 'PVACFUSE' {
        ext.args = "-e1 8,9,10,11 -e2 12,13,14,15,16,17,18 -m median --top-score-metric2 'combined_percentile','ic50'"
    }
}
