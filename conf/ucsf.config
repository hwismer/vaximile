// UCSF C4 cluster settings: SLURM, apptainer and conda. Use -profile ucsf (or -c conf/ucsf.config, not -C).

process {
    executor       = "slurm"
    time           = 14.d
    scratch        = true
    queue          = "krummellab,common"
    clusterOptions = '--gres=scratch:250G'
    errorStrategy  = 'ignore'
    maxRetries     = 2

    // OptiType needs more than its process_high tier's 48 GB here.
    withName: 'OPTITYPE' {
        cpus   = 16
        memory = 96.GB
    }
}

executor {
    name      = "slurm"
    queueSize = 50
}

conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
}

apptainer {
    enabled     = true
    autoMounts  = true
    // The container's /tmp is the job's node-local scratch: SLURM sets $TMPDIR to the space
    // requested with --gres=scratch above. Falls back to the host /tmp outside a SLURM job.
    runOptions  = '--writable-tmpfs --cleanenv -e --no-home --env PYTHONNOUSERSITE=1 -B ${TMPDIR:-/tmp}:/tmp'
    pullTimeout = "30min"
}

plugins {
    id 'nf-schema@2.8.0'
    id 'nf-google'
}
