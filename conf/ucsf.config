/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Institutional config: UCSF C4
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    nextflow run . -c conf/ucsf.config -params-file params.json -resume

    This must be -c (merge), not the -C (replace)
*/

process {
    executor       = "slurm"
    time           = 14.d
    scratch        = true
    queue          = "krummellab,common"
    clusterOptions = '--gres=scratch:250G'
    errorStrategy  = 'ignore'
    maxRetries     = 2
}

executor {
    name      = "slurm"
    queueSize = 50
}

conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
}

apptainer {
    enabled     = true
    autoMounts  = true
    runOptions  = '--writable-tmpfs --cleanenv -e --no-home --env PYTHONNOUSERSITE=1 -B $SINGULARITY_TMPDIR:/tmp -B $SINGULARITY_TMPDIR:/scratch'
    pullTimeout = "30min"
}

plugins {
    id 'nf-schema@2.8.0'
    id 'nf-google'
}
