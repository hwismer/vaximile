{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/hwismer/vaximile/main/nextflow_schema.json",
    "title": "vaximile pipeline parameters",
    "description": "Tumor neoantigen discovery using paired tumour-normal bulk DNA and RNA sequencing",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Input samplesheets and output directory.",
            "required": [
                "samplesheet",
                "capture_kits",
                "outdir"
            ],
            "properties": {
                "samplesheet": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_input.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "CSV of patients, samples and FASTQs.",
                    "fa_icon": "fas fa-file-csv"
                },
                "capture_kits": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "schema": "assets/schema_capture_kits.json",
                    "mimetype": "text/csv",
                    "pattern": "^\\S+\\.csv$",
                    "description": "CSV mapping capture kit names to target BEDs.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Output directory.",
                    "default": "./vaximile_out",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "reference_genome_options": {
            "title": "Reference genome options",
            "type": "object",
            "fa_icon": "fas fa-dna",
            "description": "Reference genome, annotation, transcriptome and proteome.",
            "properties": {
                "reference_fa": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Reference genome FASTA, plain or gzipped.",
                    "fa_icon": "fas fa-file",
                    "default": "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_49/GRCh38.primary_assembly.genome.fa.gz"
                },
                "reference_includes_chr_prefix": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the reference contigs are named with 'chr'.",
                    "fa_icon": "fas fa-tag"
                },
                "gtf": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Gene annotation GTF for RNA alignment, quantification and fusion calling.",
                    "fa_icon": "fas fa-file",
                    "default": "https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_49/gencode.v49.annotation.gtf.gz"
                },
                "transcriptome_reference": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Transcriptome FASTA for the salmon index.",
                    "fa_icon": "fas fa-file",
                    "default": "https://ftp.ensembl.org/pub/release-115/fasta/homo_sapiens/cdna/Homo_sapiens.GRCh38.cdna.all.fa.gz"
                },
                "human_ref_peptides": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Reference proteome FASTA for pVACtools' proteome similarity check.",
                    "fa_icon": "fas fa-file",
                    "default": "https://ftp.ensembl.org/pub/release-115/fasta/homo_sapiens/pep/Homo_sapiens.GRCh38.pep.all.fa.gz"
                }
            }
        },
        "alignment_index_options": {
            "title": "Alignment index options",
            "type": "object",
            "fa_icon": "fas fa-database",
            "description": "Prebuilt indexes. Any left unset are built and saved to ./vaximile_resources/.",
            "properties": {
                "bwa_index": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Prebuilt minibwa index directory.",
                    "help_text": "Must hold the .l2b and .mbw files named '<reference_fa stem>_prc.fa.<ext>'. A previous run's ./vaximile_resources/bwa_index/ works as is.",
                    "fa_icon": "fas fa-folder-open"
                },
                "star_index": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Prebuilt STAR index directory.",
                    "fa_icon": "fas fa-folder-open"
                },
                "salmon_index": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Prebuilt salmon index directory.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "downloaded_resource_options": {
            "title": "Downloaded resource options",
            "type": "object",
            "fa_icon": "fas fa-download",
            "description": "Downloaded once into ./vaximile_resources/ when not given, and reused on later runs.",
            "properties": {
                "vep_cache": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Ensembl VEP cache directory, release 115.",
                    "help_text": "Default: the GRCh38 human cache (~24 GiB). Must be release 115 to match the pipeline's VEP.",
                    "fa_icon": "fas fa-folder-open"
                },
                "vep_plugins": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory with pVACtools' Frameshift.pm and Wildtype.pm VEP plugins.",
                    "help_text": "Should come from pVACtools 7.1.5, the version the pipeline runs.",
                    "fa_icon": "fas fa-folder-open"
                },
                "ctat_resource_lib": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "STAR-Fusion CTAT library: the ctat_genome_lib_build_dir of a plug-n-play bundle.",
                    "help_text": "Default: the GRCh38 GENCODE v44 bundle (Oct 29 2023).",
                    "fa_icon": "fas fa-folder-open"
                },
                "arriba_blacklist": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Arriba blacklist.",
                    "fa_icon": "fas fa-file"
                },
                "arriba_known_fusions": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Arriba known fusions.",
                    "fa_icon": "fas fa-file"
                },
                "arriba_protein_domains": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Arriba protein domains GFF3.",
                    "fa_icon": "fas fa-file"
                },
                "ascat_resources": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "ASCAT 1000 Genomes resource directory.",
                    "help_text": "Holds G1000_loci_hg38/, G1000_alleles_hg38/, GC_G1000_hg38/ and RT_G1000_hg38/, as a previous run saves them. Loci contig names must match the reference.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "variant_calling_options": {
            "title": "Variant calling options",
            "type": "object",
            "fa_icon": "fas fa-cut",
            "description": "Interval scattering for the GATK callers.",
            "properties": {
                "interval_padding": {
                    "type": "integer",
                    "default": 100,
                    "description": "Bases of padding around each calling interval.",
                    "fa_icon": "fas fa-arrows-alt-h"
                },
                "scatter_count": {
                    "type": "integer",
                    "default": 30,
                    "description": "Number of interval shards for variant calling.",
                    "fa_icon": "fas fa-th"
                }
            }
        },
        "hla_loh_options": {
            "title": "HLA LOH options",
            "type": "object",
            "fa_icon": "fas fa-shield-virus",
            "description": "Used only for HLA LOH; HLA typing needs none of them.",
            "properties": {
                "hla_fasta": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Polysolver HLA class I reference FASTA.",
                    "default": "https://raw.githubusercontent.com/jason-weirather/hla-polysolver/9326ac2ef9b112b9bc5f25222854296097b58be5/data/abc_complete.fasta"
                },
                "hla_fasta_fai": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Index of the HLA reference FASTA.",
                    "default": "https://raw.githubusercontent.com/jason-weirather/hla-polysolver/9326ac2ef9b112b9bc5f25222854296097b58be5/data/abc_complete.fasta.fai"
                },
                "hla_kmers": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Polysolver unique HLA k-mer file.",
                    "default": "https://raw.githubusercontent.com/jason-weirather/hla-polysolver/9326ac2ef9b112b9bc5f25222854296097b58be5/data/abc_v14.uniq"
                },
                "hla_freq": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Polysolver HLA allele frequency table.",
                    "default": "https://raw.githubusercontent.com/jason-weirather/hla-polysolver/9326ac2ef9b112b9bc5f25222854296097b58be5/data/HLA_FREQ.txt"
                },
                "novoalign_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory with the novoalign and novoindex binaries. HLA LOH is skipped without it.",
                    "help_text": "Novoalign is proprietary and no longer on bioconda; download it from https://www.novocraft.com/support/download/. V4 also needs novoalign.lic in the same directory.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },
        "gatk_resource_options": {
            "title": "GATK resource bundle options",
            "type": "object",
            "fa_icon": "fas fa-archive",
            "description": "GATK resource VCFs. Each needs a matching .tbi.",
            "properties": {
                "common_germline": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Common germline SNPs for contamination estimation.",
                    "default": "gs://gatk-best-practices/somatic-hg38/small_exac_common_3.hg38.vcf.gz"
                },
                "known_sites_dbsnp": {
                    "type": "string",
                    "format": "file-path",
                    "description": "dbSNP, known sites for BQSR.",
                    "default": "gs://gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.gz"
                },
                "known_sites_1000g_snps": {
                    "type": "string",
                    "format": "file-path",
                    "description": "1000 Genomes high-confidence SNPs, known sites for BQSR.",
                    "default": "gs://gcp-public-data--broad-references/hg38/v0/1000G_phase1.snps.high_confidence.hg38.vcf.gz"
                },
                "known_indels": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Known indels for BQSR.",
                    "default": "gs://gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.known_indels.vcf.gz"
                },
                "gnomad": {
                    "type": "string",
                    "format": "file-path",
                    "description": "gnomAD allele frequencies for Mutect2.",
                    "default": "gs://gatk-best-practices/somatic-hg38/af-only-gnomad.hg38.vcf.gz"
                },
                "pon": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Panel of normals for Mutect2.",
                    "default": "gs://gatk-best-practices/somatic-hg38/1000g_pon.hg38.vcf.gz"
                },
                "hapmap": {
                    "type": "string",
                    "format": "file-path",
                    "description": "HapMap SNPs, a truth set for germline CNN filtering.",
                    "default": "gs://gcp-public-data--broad-references/hg38/v0/hapmap_3.3.hg38.vcf.gz"
                },
                "mills": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Mills gold standard indels, for BQSR and germline CNN filtering.",
                    "default": "gs://gcp-public-data--broad-references/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
                },
                "somalier_sites": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Sites for somalier's relatedness check.",
                    "default": "https://github.com/brentp/somalier/files/3412456/sites.hg38.vcf.gz"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Rarely changed options.",
            "properties": {
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "How results are saved to the output directory.",
                    "enum": [
                        "symlink",
                        "rellink",
                        "link",
                        "copy",
                        "copyNoFollow",
                        "move"
                    ],
                    "hidden": true,
                    "fa_icon": "fas fa-copy"
                },
                "help": {
                    "type": "boolean",
                    "description": "Show this help.",
                    "hidden": true,
                    "fa_icon": "fas fa-question-circle",
                    "default": false
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/reference_genome_options"
        },
        {
            "$ref": "#/$defs/alignment_index_options"
        },
        {
            "$ref": "#/$defs/downloaded_resource_options"
        },
        {
            "$ref": "#/$defs/variant_calling_options"
        },
        {
            "$ref": "#/$defs/hla_loh_options"
        },
        {
            "$ref": "#/$defs/gatk_resource_options"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
