/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    vaximile Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    // Input / output
    samplesheet                  = null
    capture_kits                 = null
    vep_cache                    = null
    outdir                       = './vaximile_out'

    // Optional prebuilt indices. Built from the reference when not supplied.
    bwa_index                    = null
    star_index                   = null
    salmon_index                 = null

    // Reference genome / annotation
    reference_fa                 = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_49/GRCh38.primary_assembly.genome.fa.gz'
    reference_includes_chr_prefix = true
    gtf                          = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_49/gencode.v49.annotation.gtf.gz'
    transcriptome_reference      = 'https://ftp.ensembl.org/pub/release-115/fasta/homo_sapiens/cdna/Homo_sapiens.GRCh38.cdna.all.fa.gz'
    human_ref_peptides           = 'https://ftp.ensembl.org/pub/current_fasta/homo_sapiens/pep/Homo_sapiens.GRCh38.pep.all.fa.gz'

    // Interval scattering. Defaults call over the whole genome using GATK WGS regions.
    interval_padding             = 100
    scatter_count                = 30

    // HLA typing references
    hla_fasta                    = 'https://raw.githubusercontent.com/jason-weirather/hla-polysolver/master/data/abc_complete.fasta'
    hla_fasta_fai                = 'https://raw.githubusercontent.com/jason-weirather/hla-polysolver/master/data/abc_complete.fasta.fai'
    hla_kmers                    = 'https://raw.githubusercontent.com/jason-weirather/hla-polysolver/master/data/abc_v14.uniq'
    hla_freq                     = 'https://raw.githubusercontent.com/jason-weirather/hla-polysolver/master/data/HLA_FREQ.txt'

    // GATK resource VCFs used for Mutect2, HaplotypeCaller and BAM pre-processing
    common_germline              = 'gs://gatk-best-practices/somatic-hg38/small_exac_common_3.hg38.vcf.gz'
    known_sites_dbsnp            = 'gs://gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.gz'
    known_sites_1000g_snps       = 'gs://gcp-public-data--broad-references/hg38/v0/1000G_phase1.snps.high_confidence.hg38.vcf.gz'
    known_indels                 = 'gs://gcp-public-data--broad-references/hg38/v0/Homo_sapiens_assembly38.known_indels.vcf.gz'
    gnomad                       = 'gs://gatk-best-practices/somatic-hg38/af-only-gnomad.hg38.vcf.gz'
    pon                          = 'gs://gatk-best-practices/somatic-hg38/1000g_pon.hg38.vcf.gz'
    hapmap                       = 'gs://gcp-public-data--broad-references/hg38/v0/hapmap_3.3.hg38.vcf.gz'
    mills                        = 'gs://gcp-public-data--broad-references/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
    somalier_sites               = 'https://github.com/brentp/somalier/files/3412456/sites.hg38.vcf.gz'

    // Boilerplate
    publish_dir_mode             = 'copy'
    version                      = false
    help                         = false
}

outputDir = '.'
workflow.output.mode = params.publish_dir_mode

// Load conf/base.config for all pipeline runs
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes             = true
        process.beforeScript   = 'echo $HOSTNAME'
        cleanup                = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        apptainer.enabled      = false
        conda.channels         = ['conda-forge', 'bioconda']
    }
    docker {
        docker.enabled         = true
        conda.enabled          = false
        singularity.enabled    = false
        apptainer.enabled      = false
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        conda.enabled          = false
        docker.enabled         = false
        singularity.enabled    = false
    }
    ucsf { includeConfig 'conf/ucsf.config' }
}

// Load modules.config for module-specific options
includeConfig 'conf/modules.config'

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
    JULIA_DEPOT_PATH = '/usr/local/share/julia'
}

// Set bash options
process.shell = [
    'bash',
    '-C',         // No clobber - prevent output redirection from overwriting files.
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',
    'pipefail'    // Returns the status of the last command to exit with a non-zero status
]

manifest {
    name            = 'vaximile'
    author          = 'Harrison Wismer'
    homePage        = 'https://github.com/hwismer/vaximile'
    description     = 'Tumor neoantigen discovery using paired tumour-normal bulk DNA and RNA sequencing'
    mainScript      = 'vaximile.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0dev'
}

// Nextflow plugins

plugins {
    id 'nf-schema@2.8.0'
}
